# AI Traffic Enforcement System - Environment Configuration
# Copy this file to .env and configure values appropriately.
# NEVER commit sensitive API keys or credentials to version control.

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# Database Configuration
DATABASE_TYPE=sqlite
DATABASE_PATH=./database/db.sqlite
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/traffic_enforcement_db

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_string_in_production
JWT_EXPIRATION_HOURS=24
BCRYPT_SALT_ROUNDS=10

# AI Model Checkpoint Paths
YOLO_VEHICLE_MODEL=./ai_models/weights/yolov8n.pt
YOLO_PLATE_MODEL=./ai_models/weights/yolov8n-license-plate.pt
OCR_MODEL_PATH=./ai_models/weights/lprnet_ocr.pth
CONFIDENCE_THRESHOLD=0.85
IOU_THRESHOLD=0.45

# Storage & Output Paths
OUTPUT_DIR=./outputs
EVIDENCE_DIR=./outputs/evidence
CROPS_DIR=./outputs/crops
REPORTS_DIR=./outputs/reports
VIDEOS_DIR=./outputs/videos

# Enforcement Rules
DEFAULT_SPEED_LIMIT_KMH=60
SPEED_VIOLATION_TOLERANCE_KMH=5
ENFORCE_RED_LIGHT=true
ENFORCE_HELMET=true
ENFORCE_STOP_LINE=true
ENFORCE_WRONG_WAY=true

# Challan Defaults
DEFAULT_FINE_CURRENCY=INR
SPEEDING_FINE=1000
RED_LIGHT_FINE=1500
NO_HELMET_FINE=500
WRONG_WAY_FINE=2000
